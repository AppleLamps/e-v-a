# --- Heavy / regenerable inputs ----------------------------------------
# Raw PDFs (~310 MB) — regenerate from sources/ via scripts/download-pdfs.mjs
court-case-pdf/*.pdf
court-case-pdf/*.part

# Raw HTML inputs from CourtListener (~8 MB) — only needed when re-scraping
sources/

# Run logs — local debugging only
logs/
*.log

# UI audit reports and screenshot evidence — generated local review artifacts
audit/

# Backup of pre-stripped wiki scrapes — redundant with case-files/
case-files-backup/

# Failure logs written by scripts/download-pdfs.mjs and scripts/extract-pdfs.mjs
download-failures.log
extract-failures.log

# --- Local / OS / editor junk -----------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.temp
*.bak

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment / secrets
.env
.env.local
.env.*.local

# Python (in case you add extraction tools later)
__pycache__/
*.py[cod]
.venv/
venv/

# Claude / IDE assistant scratch
.claude/

# Vercel build output (when site/ is deployed)
site/.vercel/
